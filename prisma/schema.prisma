// Prisma Schema for StagingStudio

// Datasource
// Prisma 7 forbids `datasource.url` in the schema: the URL must live in
// `prisma.config.ts` (used by the Prisma CLI for `db push`, `db studio`,
// `migrate`, etc.) and a driver adapter (see `src/lib/prisma.ts` and the
// e2e harness under `tests/e2e/`) is what feeds the PrismaClient at
// runtime. See https://pris.ly/d/prisma7-client-config and
// https://pris.ly/d/config-datasource.
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// User model: firm branding and editable page templates
model User {
  id                    String    @id @default(cuid())
  firmName              String    // "Circle G Designs"
  ownerName             String    // "Lauren Chapin"
  logoUrl               String?
  email                 String?   @unique
  psychologyPageContent String?   // Template for Page 2
  signoffContent        String?   // Template for final page
  darkMode              Boolean   @default(false)
  createdAt             DateTime  @default(now())

  projects Project[]
}

// Project model: a single staging job for one property
model Project {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyAddress String
  clientName      String
  targetBuyer     String   // e.g. "young professional couple", "growing family"
  stagingAesthetic String  // e.g. "Organic Modern Luxury", "Warm Transitional"

  // ROI Metrics Dashboard (issue #552)
  roiSalesPricePremium   String? // e.g. "+8–12%"
  roiTransactionVelocity  String? // e.g. "24 Days"
  roiInvestmentTier      String? // e.g. "$45,000"

  stagingPackage   String? // e.g. "essential", "premium", "turnkey"
  stagingDirectives String? // Issue #562: global project-wide AI staging directives
  // Buyer Demographics JSON: buyer profile for AI copywriting + ROI metrics (issue #563)
  // Shape: { buyerType, designPreferences[], budgetMin, budgetMax, mustHaveFeatures[], sellTimeline }
  buyerDemographics Json?
  // Client digital sign-off (issue #556)
  clientSignature          String?   // PNG data URL of the signature
  clientSignatureStatus    String?   // "Pending" | "Signed"
  clientSignatureTimestamp  DateTime? // ISO 8601 timestamp of when signed
  // Issue #1113: explicit attestation that the client reviewed and
  // agreed to the legally-worded approval text on the sign-off form.
  // Persisted (not just a client-side flag) so the attestation is
  // auditable: a `Signed` project without a recorded `clientConsentAttestedAt`
  // exposes that the prior control was decorative.
  clientConsentAttested    Boolean   @default(false)
  clientConsentAttestedAt  DateTime? // ISO 8601 timestamp of attestation

  // Issue #1186: "Virtually staged" disclosure mark on AI after-images.
  // Project-scoped so Lauren can match her local MLS / listing-agent
  // requirement per market. Defaults ON: an unlabelled staged photo is the
  // exact thing the disclosure exists to prevent. Null on existing rows
  // is treated as enabled by `resolveVirtuallyStagedLabelEnabled`.
  virtuallyStagedLabelEnabled Boolean? @default(true)

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rooms Room[]
  materialSwatches MaterialSwatch[]
  procurementItems ProcurementItem[]
}

// Room model: a single room within a project
model Room {
  id                   String   @id @default(cuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                 String   // e.g. "Primary Bedroom", "Kitchen"

  // Image URLs — Variant 1
  beforeImageUrl       String?
  afterImageUrl        String?

  // Image URLs — Variant 2
  beforeImageUrl2      String?
  afterImageUrl2       String?

  selectedVariantIndex Int?     @default(0) // 0 or 1 — which variant is selected for PDF

  // AI outputs
  rawDirectives        String?  // User's freeform bullet directives
  observedChallenge    String?
  recommendation       String?
  buyerPsychology      String?
  checklistItems       Json?    // Array of { item, category, priority }

  // Issue #1343: Listing copy columns for the redesigned CopyPanel.
  // Both nullable strings so an existing room can ship without any
  // listing copy and the lookbook render falls back to the legacy
  // `recommendation` field (see `resolveListingCopy` in
  // `src/lib/listing-copy.ts`). Distinct from the consultation-copy
  // fields above: this is the headline + body the lookbook shows
  // next to the room's photo spread — the "what an agent writes
  // about this room" snippet, not the staged-priority prose.
  lookbookHeadline     String?
  lookbookBody         String?

  // Issue #1362a — FineTune persistence columns. Three nullable columns
  // mirror the FineTune UI's three surviving controls after the §8
  // Q1/Q3 + Gemini-finding cleanup (adherence and shadows removed;
  // creativeMode + lockSeed never had UI controls):
  //   - strength 0..100, UI percent → maps to DashScope `parameters.strength` (0..1)
  //   - expand 0..40, pre-upload mask feathering radius in pixels
  //   - seed: up to 6 digits (digits-only constraint enforced by Zod)
  // All three are nullable so existing rooms ship without any FineTune
  // state and the UI falls back to its defaults (strength=50 → 0.5,
  // expand=12, seed=""). Stage A only persists; Stage B (#1362b) wires
  // the persisted values into the DashScope request.
  fineTuneStrength     Int?
  fineTuneExpand       Int?
  fineTuneSeed         String?

  sortOrder           Int      @default(0) // for manual room reordering

  createdAt            DateTime @default(now())

  inpaintRequests InpaintRequest[]
  inpaintVersions InpaintVersion[]
  selectionLogs  SelectionLog[]

  // Issue #1182: room-level finish reuse. When a room has multiple
  // photos (different angles of the same kitchen, etc.) the user can
  // save one chosen finish (MaterialSwatch + directives + concept
  // label) on the room, then opt-in to seed it into the next photo's
  // inpaint directives. Nullable + onDelete: SetNull so removing the
  // referenced swatch clears the choice without cascade-deleting the
  // room's directive text.
  materialFinishId        String?
  materialFinish          MaterialSwatch? @relation("RoomMaterialFinish", fields: [materialFinishId], references: [id], onDelete: SetNull)
  materialFinishDirectives  String? // the staging directives captured with the finish
  materialFinishConceptLabel String? // the SAM/GPT-4o-mini concept label captured with the finish

  @@index([projectId])
}

// InpaintRequest model: persisted fal.ai queue request (id = fal requestId)
// so jobs survive serverless deadlines and page refreshes can resume polling.
model InpaintRequest {
  id          String   @id
  roomId      String
  room        Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  variantSlot Int      // 0 or 1 — which "after" variant slot this run targets
  sourceSlot  Int?     // issue #170: null = run edits the original before photo;
                       // 0 or 1 = run edits that variant's staged result and
                       // overwrites its "after" slot in place (selection untouched).
                       // Persisted so a pendingRequestId resume can apply the same
                       // result-persistence semantics as the original submit.
  status      String   // mirrors fal queue status: IN_QUEUE | IN_PROGRESS | COMPLETED | ERROR | PERSISTENCE_FAILED
  resultUrl   String?  // filled when status is COMPLETED
  falResultUrl String? // issue #1143: the provider's own result URL, memoized the moment it is known so a PERSISTENCE_FAILED retry never re-fetches it
  persistenceAttempts Int @default(0) // issue #1143: provider-touching persistence attempts since entering PERSISTENCE_FAILED; caps the retry loop
  lastPersistenceAttemptAt DateTime? // issue #1143: gates the exponential backoff between persistence attempts
  providerJobId String? @unique // issue #1221: the provider's own job id (fal request_id /
                       // Replicate prediction id). Lets the webhook delivery path
                       // match a callback to this row even when the URL path was
                       // tampered with. Backfilled on submit; legacy polling rows
                       // keep null (their id IS the fal request_id).
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([roomId])
}

// InpaintVersion model: version history for inpaint results (issue #561).
// Tracks each completed inpaint run per variant slot so users can preview,
// restore, and compare previous versions. Thumbnails are stored in Supabase
// Storage; full images use the resultUrl (persisted in staging-images).
model InpaintVersion {
  id             String   @id @default(cuid())
  roomId         String
  room           Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  variantSlot    Int      // 0 or 1 — which "after" variant slot this version belongs to
  resultUrl      String   // URL of the full-resolution image (from staging-images)
  thumbnailUrl   String?  // URL of the low-res thumbnail in Supabase Storage
  seed           String?  // fal.ai seed used for this run (for regeneration)
  promptDirectives String? // The staging directives used for this run
  createdAt      DateTime @default(now())

  @@index([roomId, variantSlot, createdAt])
}

// VisionLabel model: caches GPT-4o-mini vision labels for detected instances
// so re-opening the editor does not re-bill (issue #266).
// userId scopes cache entries per-user so one user's billed labels are not
// served to another user at no cost (issue #774).
// VisionLabel stands alone: no owner relation, so it survives room deletes.
// The cache key is (userId, imageUrlHash, concept, instanceIndex); roomId is
// a nullable denormalised filter column only (not a FK, not cascade-linked).
model VisionLabel {
  id             String   @id @default(cuid())
  imageUrlHash   String   // hash of imageUrl (stable identifier)
  concept        String   // e.g. "furniture", "rug", etc.
  instanceIndex  Int
  label          String   // GPT-4o-mini label text
  score          Float?
  userId         String  // scopes cache to the user who paid
  roomId         String?  // nullable denormalised filter column only
  createdAt      DateTime @default(now())

  @@unique([userId, imageUrlHash, concept, instanceIndex])
  @@index([roomId])
}

// SelectionLog model: durable log of every instance toggle for the training
// corpus (find-and-replace initiative, issue #238 / wave W3).
// Rows are written alongside console events so the training data survives
// past the browser console — the corpus export script dumps this table.
model SelectionLog {
  id            String   @id @default(cuid())
  roomId        String
  concept       String
  instanceIndex Int
  score        Float
  editedLabel  String?
  createdAt    DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

// MaterialSwatch model: finish and palette references displayed in the lookbook
// (issue #553). Belongs to a project so swatches are shared across rooms.
model MaterialSwatch {
  id           String  @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String  // e.g. "White Oak", "Brushed Brass", "Cream Linen"
  hexCode      String  // e.g. "#C8A882", "#B8860B"
  materialType String  // e.g. "Hardwood", "Metal", "Fabric"
  useCase     String  // e.g. "Flooring", "Hardware", "Textile"
  vendor      String? // e.g. "Wayfair", "Sherwin-Williams"
  sku         String? // e.g. "WF-HW-1234"
  sortOrder   Int     @default(0)

  roomsUsingFinish Room[] @relation("RoomMaterialFinish") // issue #1182 inverse

  @@index([projectId])
}

// ProcurementItem model: furniture procurement items for the lookbook's
// Furniture Procurement Table (issue #554).
model ProcurementItem {
  id            String   @id @default(cuid())
  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category     String  // e.g. "Seating", "Tables", "Lighting"
  item         String  // e.g. "Sofa", "Dining Table", "Floor Lamp"
  description  String?
  status      String  // "needed" | "ordered" | "received"
  sku         String?
  estCost     Float?
  vendor      String?
  notes       String?
  sortOrder   Int     @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

// DailyApiUsage model: Postgres-backed daily counter for copy/export/segment/label
// surfaces, replacing the in-process Map that had multi-instance race conditions
// on serverless platforms (issue #784).
model DailyApiUsage {
  id        String   @id @default(cuid())
  userId    String
  surface   String
  dayKey    String
  count     Int      @default(0)
  timestamps DateTime[] @default([])
  updatedAt DateTime @updatedAt

  @@unique([userId, surface, dayKey])
  @@index([userId, surface, dayKey])
}

// SetupRateLimit model: IP-based rate limiting for the setup password flow.
// Tracks failed attempts per hashed IP with a sliding one-hour window.
// On 10 failed attempts within the window the IP is locked for the remainder
// of the window duration. Resets atomically on a successful setup.
model SetupRateLimit {
  id          String    @id @default(cuid())
  ipHash      String    @unique  // SHA-256 of client IP, stored not raw
  attemptCount Int       @default(0)
  windowStart  DateTime  @default(now()) // start of current rate-limit window
  lockedUntil  DateTime?           // optional hard lockout until this time
  updatedAt    DateTime  @updatedAt

  @@index([ipHash])
}
