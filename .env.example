# AI / Image
OPENAI_API_KEY=your_openai_api_key
FAL_KEY=your_fal_ai_key

# PDF Export
BROWSERLESS_API_KEY=your_browserless_api_key
NEXT_PUBLIC_APP_URL=http://localhost:3000
