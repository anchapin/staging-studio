# StagingStudio env template — copy to .env.local (`cp .env.example .env.local`).
# Each key carries a one-line annotation: what reads it, where to source it, required/optional.

# Supabase — all Supabase values come from the Supabase dashboard (Project Settings).

# Required — Prisma Postgres connection string (prisma/schema.prisma datasource); dashboard → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Required — Supabase project URL, read by middleware.ts, lib/supabase.ts, api/setup*, auth/callback; dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT].supabase.co

# Required — anon public key (browser-safe by design), read wherever the project URL is; dashboard → Project Settings → API → anon public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Reserved — NOT read by any code today; do not distribute unless you add server-side admin usage; would come from dashboard → Project Settings → API → service_role key (server-side only).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI services.

# Required — OpenAI key read by lib/ai.ts (call-time check) for gpt-4o-mini lookbook copy; source: platform.openai.com → API keys.
OPENAI_API_KEY=your_openai_api_key

# Required — Alibaba Cloud DashScope API key for the inpaint surface
# (Qwen-Image-2.1 Pro as of #1240). Source: Alibaba Cloud console →
# Model Studio → API keys. The key is region-bound: a Singapore or US-East
# key cannot call the Beijing endpoint, and vice versa. Set the same
# region for ALIBABA_BAILIAN_WORKSPACE_ID below.
ALIBABA_DASHSCOPE_API_KEY=your_dashscope_api_key

# Required — Bailian (Model Studio) workspace id. The workspace id alone
# implies its region (Singapore workspaces live on ap-southeast-1).
# Visible in the Bailian console URL bar, e.g. llm-x83c15vnd001kxij.
ALIBABA_BAILIAN_WORKSPACE_ID=llm-xxxxxxxxxxxxxx

# Optional — DashScope model id to use for the inpaint surface.
# Default qwen-image-2.1-pro (Singapore-verified). Other verified models
# on Singapore: qwen-image-2.1-turbo, qwen-image-2.0-pro. The
# qwen-image-edit* aliases return 404 on the Singapore endpoint; the
# unified 2.1 / 2.0 model names accept image + text content in the
# multimodal-conversation request and serve as the edit-capable surface.
ALIBABA_INPAINT_MODEL=qwen-image-2.1-pro

# Optional — selects the inference provider. Defaults to "alibaba". As of
# #1240 only "alibaba" is wired; "fal" and "replicate" parse but throw a
# clear error at configure time so a stale deploy surfaces the issue
# rather than silently falling through to Alibaba.
INFERENCE_PROVIDER=alibaba

# Dana-rig only — NOT read by the app (zero consumers in src/ or middleware.ts); consumed by docs/dana-rig/ tooling (triage.js, nightly.sh, nightly-compose.sh) for offline Dana finding triage. Optional for the app; required only if you run the Dana rig. Source: typesafe.ai.
TYPESAFE_API_KEY=

# PDF export and the app's public origin.

# Required for PDF export — Browserless.io account key read by api/export-pdf (500 error when missing); source: browserless.io → account API keys.
BROWSERLESS_API_KEY=your_browserless_api_key

# App public origin (not a PDF-export-only value) — read by api/export-pdf to build the cookie-less preview URL its cloud browser fetches; dev fallback http://localhost:3000, required and must be publicly reachable in production. Local PDF export needs a public tunnel (Browserless's cloud Chrome cannot reach localhost): run scripts/dev-tunnel.sh (cloudflared or ngrok) to point this at the tunnel URL, then restart `npm run dev` — see docs/DEPLOYMENT.md.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Hermetic e2e harness only (issue #1084) — NOT set for normal dev or production; `npm run e2e` supplies both via nextEnv() in tests/e2e/env.ts. E2E_HERMETIC is the guard that keeps the endpoint override below inert everywhere else: E2E_BROWSERLESS_PDF_URL is honored ONLY when E2E_HERMETIC is exactly "1", so a stray value here cannot redirect outbound PDF bytes. Server-only, never NEXT_PUBLIC_ (must not reach client bundles). Override the PDF endpoint when you need the real api/export-pdf handler to talk to a local mock instead of the paid Browserless API, which is how the e2e suite avoids a real call the server-side fetch cannot intercept.
E2E_HERMETIC=
E2E_BROWSERLESS_PDF_URL=

# Required in production (optional in dev: fixed public fallback is used when unset) — HMAC secret signing short-lived (5 min) lookbook-preview tokens, read by lib/preview-token.ts; generate with: openssl rand -base64 32.
PREVIEW_TOKEN_SECRET=

# Required in production (optional in dev: fixed public fallback is used when unset) — AES-GCM-256 key for the client-signature data URL, read by lib/signature-encryption.ts and enforced by /api/sign-project and saveProjectSignature. The signature PNG is never stored in plaintext. Generate with: openssl rand -base64 32.
SIGNATURE_ENCRYPTION_KEY=

# Daily per-user API cost guardrails (issue #201), read by lib/api-quota.ts via the five paid-API surfaces (inpaint, copy, label, export, segment). Optional — omit for the defaults shown below. "Daily" is the server-local calendar day. Set 0 to block a surface entirely. All five are counted in the DailyApiUsage table in Postgres (issues #784, #1131), so usage survives a cold start and is shared across instances, and no delete in the app can refund it. Known limit: each cap is checked before the provider call and charged after it, so a burst of concurrent requests can overshoot (issues #1111, #1132). NOTE: the DailyApiUsage table must exist in the target database (`npm run db:push`) for those caps to work at all — an operator provisioning the app gets no signal of this otherwise.

# Optional — Alibaba Cloud DashScope inpaint submissions allowed per user per day, read by api/inpaint; default 20. Charged per successful submit against the `inpaint` counter row — NOT counted from InpaintRequest rows, which cascade-delete with the room and used to let a room delete refund the cap (issue #1131). The cap is per-image (matches Qwen-Image's per-image pricing), not per-megapixel like the prior fal.ai FLUX.1 Fill.
DAILY_INPAINT_LIMIT=20

# Optional — OpenAI gpt-4o-mini copy generations allowed per user per day, read by api/generate-copy; default 50.

# Optional — OpenAI gpt-4o-mini vision label-instance generations allowed per user per day, read by api/label-instances and the room-batch server action; default 50.
DAILY_LABEL_LIMIT=50

# Optional — Browserless PDF exports allowed per user per day, read by api/export-pdf; default 20. Counted in the same DailyApiUsage table as every other surface, so it shares the inpaint limit's check-then-act window rather than being weaker or stronger than it (issues #784, #1132).
DAILY_EXPORT_LIMIT=20

# Optional — fal.ai SAM 3.1 segmentation calls allowed per user per day, read by api/segment/furnishings; default 100.
DAILY_SEGMENT_LIMIT=100
