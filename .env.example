# StagingStudio env template — copy to .env.local (`cp .env.example .env.local`).
# Each key carries a one-line annotation: what reads it, where to source it, required/optional.

# Supabase — all Supabase values come from the Supabase dashboard (Project Settings).

# Required — Prisma Postgres connection string (prisma/schema.prisma datasource); dashboard → Project Settings → Database → Connection string.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Required — Supabase project URL, read by middleware.ts, lib/supabase.ts, api/setup*, auth/callback; dashboard → Project Settings → API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT].supabase.co

# Required — anon public key (browser-safe by design), read wherever the project URL is; dashboard → Project Settings → API → anon public key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Reserved — NOT read by any code today; do not distribute unless you add server-side admin usage; would come from dashboard → Project Settings → API → service_role key (server-side only).
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI services.

# Required — OpenAI key read by lib/ai.ts (call-time check) for gpt-4o-mini lookbook copy; source: platform.openai.com → API keys.
OPENAI_API_KEY=your_openai_api_key

# Required — fal.ai key read by lib/fal.ts (throws at import when missing) for FLUX.1 Fill inpainting; source: fal.ai dashboard → keys.
FAL_KEY=your_fal_ai_key

# Dana-rig only — NOT read by the app (zero consumers in src/ or middleware.ts); consumed by docs/dana-rig/ tooling (triage.js, nightly.sh, nightly-compose.sh) for offline Dana finding triage. Optional for the app; required only if you run the Dana rig. Source: typesafe.ai.
TYPESAFE_API_KEY=

# PDF export and the app's public origin.

# Required for PDF export — Browserless.io account key read by api/export-pdf (500 error when missing); source: browserless.io → account API keys.
BROWSERLESS_API_KEY=your_browserless_api_key

# App public origin (not a PDF-export-only value) — read by api/export-pdf to build the cookie-less preview URL its cloud browser fetches; dev fallback http://localhost:3000, required and must be publicly reachable in production. Local PDF export needs a public tunnel (Browserless's cloud Chrome cannot reach localhost): run scripts/dev-tunnel.sh (cloudflared or ngrok) to point this at the tunnel URL, then restart `npm run dev` — see docs/DEPLOYMENT.md.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required in production (optional in dev: fixed public fallback is used when unset) — HMAC secret signing short-lived (5 min) lookbook-preview tokens, read by lib/preview-token.ts; generate with: openssl rand -base64 32.
PREVIEW_TOKEN_SECRET=

# Daily per-user API cost guardrails (issue #201), read by lib/api-quota.ts via the five paid-API surfaces (inpaint, copy, label, export, segment). Optional — omit for the defaults shown below. "Daily" is the server-local calendar day. Set 0 to block a surface entirely. NOTE: the inpaint limit is enforced exactly (counted from InpaintRequest rows in Postgres); the copy/label/export/segment limits use an in-process counter that resets on serverless cold start and can under-count across instances (see lib/api-quota.ts).

# Optional — fal.ai FLUX.1 Fill inpaint submissions allowed per user per day, read by api/inpaint; default 20.
DAILY_INPAINT_LIMIT=20

# Optional — OpenAI gpt-4o-mini copy generations allowed per user per day, read by api/generate-copy; default 50.
DAILY_COPY_LIMIT=50

# Optional — OpenAI gpt-4o-mini vision label-instance generations allowed per user per day, read by api/label-instances and the room-batch server action; default 50.
DAILY_LABEL_LIMIT=50

# Optional — Browserless PDF exports allowed per user per day, read by api/export-pdf; default 20. Enforced by an in-process counter, NOT exact like the inpaint limit above: it resets on restart/serverless cold start and is per-instance (per-lambda on Vercel), so the daily cap can under-count — accepted for this single-tenant deployment (#716).
DAILY_EXPORT_LIMIT=20

# Optional — fal.ai SAM 3.1 segmentation calls allowed per user per day, read by api/segment/furnishings; default 100.
DAILY_SEGMENT_LIMIT=100
