# Supabase
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres

# Auth
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI / Image
OPENAI_API_KEY=your_openai_api_key
FAL_KEY=your_fal_ai_key

# PDF Export
BROWSERLESS_API_KEY=your_browserless_api_key
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Secret used to sign short-lived (5 min) preview tokens that let the
# cookie-less PDF exporter render /projects/:id/preview. Required in
# production; generate with: openssl rand -base64 32
# When unset, a fixed dev-only fallback is used (NOT safe for production).
PREVIEW_TOKEN_SECRET=
