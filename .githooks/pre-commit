#!/usr/bin/env sh
# Pre-commit hook: blocks committing the Next.js tsconfig.jsx build flip.
# Activated automatically by scripts/enable-hooks.sh (the `prepare` lifecycle
# script) on `npm install`. To do it by hand:
#   git config core.hooksPath .githooks
# See AGENTS.md "Toolchain quirks".
exec "$(git rev-parse --show-toplevel)/scripts/check-tsconfig-flip.sh"
